# ===================================================================
# DraftMate Evidence Intelligence — Production Environment Configuration
# ===================================================================

# -------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Render Backend)
# -------------------------------------------------------------------
PORT=5001
NODE_ENV=production

# Database Connection (Render Managed PostgreSQL or external PostgreSQL)
# Example: postgresql://draftmate_user:password@dpg-xxxx-a:5432/draftmate
DATABASE_URL=postgresql://user:password@hostname:5432/draftmate

# Cryptographically secure random JWT secret (Min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_characters
JWT_EXPIRES_IN=7d

# Google Gemini API Key for Indian Legal AI Drafting and Risk Analysis
# Obtain at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (Comma-separated)
# Set this to your deployed Netlify frontend domain
# Example: https://draftmate-ai.netlify.app
CORS_ORIGIN=https://draftmate-ai.netlify.app

# Optional: SMTP Email Configuration for Password Resets
# If unset, password reset tokens are safely displayed in development/demo mode
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=DraftMate Security <noreply@your-domain.com>

# -------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Netlify Build Environment)
# -------------------------------------------------------------------
# Point your Netlify frontend to your deployed Render backend URL:
# Set this environment variable in the Netlify Dashboard: Site configuration > Environment variables
VITE_API_BASE_URL=https://draftmate-ai-m5gz.onrender.com
