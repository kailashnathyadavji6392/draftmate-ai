# DraftMate Evidence Intelligence Configuration
PORT=5001
NODE_ENV=production

# Server-Side Authentication & Session Security (REQUIRED in production)
# Generate a cryptographically strong 32+ character key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_characters
JWT_EXPIRES_IN=7d

# Server-Side AI Secrets (NEVER expose to frontend or commit to version control)
# Google Gemini API Key for Live LLM Drafting & Legal Intelligence
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: CORS Allowed Origins (Comma-separated)
# In unified single-service deployments (e.g. Render Web Service), leave empty.
# In decoupled deployments (e.g. Vercel frontend + Render backend), set to your frontend domain:
# CORS_ORIGIN=https://draftmate-ai.onrender.com
CORS_ORIGIN=

# Optional: Production Email SMTP Delivery for Password Resets
# If unconfigured, the system safely provides single-use reset tokens directly for developer/demo access.
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=DraftMate Security <noreply@your-domain.com>
